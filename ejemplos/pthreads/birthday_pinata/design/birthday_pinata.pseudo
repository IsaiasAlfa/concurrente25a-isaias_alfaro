procedure main(argc, argv[])
  // mutex to hit the pinata
  shared can_hit := create_mutex()
  shared thread_count := integer(argv[1])
  // vida de la pinata
  chares healt := integer(argv[2])
  for thread_number := 0 to thread_count do
    create_thread(greet, thread_number) // thread team
  end for
end procedure

// metodo para simular los golpes
procedure race(thread_number)
  // entrar a can?hit evita condicion de carrera
  lock(can_hit)
  // numero random de 0 a vida de la pinata
  hit = random {0, healt}
  // restarle la vida a la pinata
  healt - hit
  // imprimir los golpes y si rompio la pinata
  print "Thread ", thread_number, "/", thread_count ": hits",
  unlock(can_hit)
end procedure