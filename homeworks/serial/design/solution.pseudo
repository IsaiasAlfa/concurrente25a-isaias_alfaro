procedure main()
Definir variable filename como arreglo de 100 caracteres
Mostrar mensaje "Ingresa el nombre del archivo: "
Leer entrada del usuario en filename (hasta 100 caracteres)
Reemplazar el salto de línea al final de filename con el carácter nulo '\0'

Si filename contiene la subcadena "job":
    Mostrar "Nombre del archivo ingresado: filename"
    Llamar a make_data con filename
Sino:
    Mostrar "Nombre del archivo no encontrado o incorrecto"
end procedure
