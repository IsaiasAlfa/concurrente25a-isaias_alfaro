procedure main()
  shared oxigen_multiplex := semaphor(1)
  shared hydrogen_multiplex := sempahore(2)
  ahared device_barrier := barrier(3)

  while read atom do
    case atom of
      'H': create_thread(hydrogen)
      'O': create_thread(oxygen)
    end case
  end while
end procedure

procedure hydrogen()
  wait(hydrogen_multiplex)
    wait(device_barrier)
      bond()
    wait(device_barrier)
  signal(hydrogen_multiplex)
end procedure

procedure oxygen()
  wait(oxigen_multiplex)
    wait(device_barrier)
      bond()
    wait(device_barrier)
  signal(oxigen_multiplex)
end procedure
