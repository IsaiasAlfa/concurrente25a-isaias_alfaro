procedure main()
  shared male_queue := semaphore(0)
  shared female_queue := semaphore(0)
  while read genre do
    case genre of
      'M': create_thread(male)
      'W': create_thread(female)
    end case
  end while
end procedure

procedure male()
  signal(male_queue)
    wait(female_queue)
      dance()
  
end procedure

procedure female()
signal(feale_queue)
  wait(male_queue)
    dance()
end procedure
