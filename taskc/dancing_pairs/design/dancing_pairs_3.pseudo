procedure main()
  shared male_queue := semaphore(1)
  shared female_queue := semaphore(1)
  shared room_barrier := barrier(2)
  while read genre do
    case genre of
      'M': create_thread(male)
      'W': create_thread(female)
    end case
  end while
end procedure

procedure male()
  wait(male_queue)
    wait(room_barrier) // Wait ti enter to room
      dance()
    wait(room_barrier) // wait to exti rom, optional, but tidy
  signal(male_queue)
end procedure

procedure female()
wait(female_queue)
  wait(room_barrier) // Wait ti enter to room
    dance()
  wait(room_barrier) // wait to exti rom, optional, but tidy
signal(female_queue)
end procedure
