procedure main()
  input const skater_count as integer, const room_capacity as integer
  shared can_skate := sempahore(room_capacity)
  join_threads(create_threads(skater_count, skater)) 
end procedure

procedure skater()
  // Concurrency-bounded region
  wait(can_skate)
    skate()
  signal(can_skate)
end procedure
