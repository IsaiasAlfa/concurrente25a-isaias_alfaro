procedure main()
  // How many threads have arrived to the barrier
  shared count := 0
  shared count2 := 0
  // Protects the increment of the count
  shared can_access_count := create_semaphore(1)
  shared can_access_count2 := create_semaphore(1)
  // Locked (0) until all threads arrive, then it is unlocked (1)
  shared barrier := create_semaphore(0)
  shared barrier2 := create_semaphore(0)
  // Read thread count from standard input
  input shared const thread_count as integer
  // Create a thread team running secondary
  join_threads(create_threads(thread_count, secondary))
end procedure

procedure secondary()
  while true do
    Statement A
    // if I am the last one thread to arraive the barrier
    // Statement B can be only executed until all threads have run Statement A
    wait(can_access_count)
      count = count + 1
      if count = thread_count then
        count = 0
        signal(barrier, thread_count)
      end if
    signal(can_access_count)
    wait(barrier)

    Statement B

    wait(can_access_count2)
    count2 = count2 + 1
    if count2 = thread_count then
      count2 = 0
      signal(barrier2, thread_count)
    end if
    signal(can_access_count2)
    wait(barrier2)
  end do
end procedure
